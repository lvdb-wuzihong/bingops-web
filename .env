# ============================================================
# BingOps 多环境配置（公共默认，入库）
# 形态：跨域直连线上后端，后端 CORS 需允许前端域名
# ------------------------------------------------------------
# 本地调试后端时，新建 .env.development.local 覆盖（*.local 已被
# gitignore，不入库，不影响他人）：
#   VITE_API_BASE_URL=                          （置空 = 走同域）
#   VITE_PROXY_TARGET=http://127.0.0.1:8000     （dev 代理指向本地后端）
# 删除该文件即恢复线上直连。改完需重启 dev server。
# ============================================================

VITE_API_BASE_URL=https://bingops-api.povison-inc.com
